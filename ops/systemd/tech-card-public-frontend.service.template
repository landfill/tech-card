[Unit]
Description=Tech Card public frontend (Vite preview)
After=network-online.target tech-card-public-backend.service
Wants=network-online.target tech-card-public-backend.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__/frontend
EnvironmentFile=-__ROOT__/frontend/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/npm run build:public
ExecStart=/usr/bin/npm run preview:public -- --host 0.0.0.0 --port 5173 --strictPort
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

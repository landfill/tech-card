[Unit]
Description=Tech Card public FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
EnvironmentFile=-__ROOT__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__ROOT__/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

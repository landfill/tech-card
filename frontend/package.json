{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:public",
    "dev:public": "vite --mode public --open /index.public.html",
    "dev:admin": "vite --mode admin --open /index.admin.html",
    "build": "npm run build:public && npm run build:admin",
    "build:public": "tsc -b && vite build --mode public",
    "build:admin": "tsc -b && vite build --mode admin",
    "lint": "eslint .",
    "preview": "npm run preview:public",
    "preview:public": "vite preview --mode public --outDir dist-public",
    "preview:admin": "vite preview --mode admin --outDir dist-admin"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
